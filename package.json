{
  "name": "shelfhelp",
  "version": "0.19.0",
  "description": "Sync Hardcover lists into Audiobookshelf collections, with a Seerr-style web UI",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node --no-warnings=ExperimentalWarning dist/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@hardcover/sdk": "^0.1.0",
    "fastify": "^5.12.7",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
